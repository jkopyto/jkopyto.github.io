---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{%- for p in site.pages -%}
  {%- unless p.sitemap == false or p.noindex or p.name == '404.html' or p.name == 'sitemap.xml' or p.name == 'test.html' or p.path contains 'assets/' or p.path contains 'favicon' or p.url contains '.json' -%}
  <url>
    <loc>{{ p.url | replace:'index.html','' | replace:'.html','' | prepend: site.url }}</loc>
    {%- if p.last_modified %}<lastmod>{{ p.last_modified | date_to_xmlschema }}</lastmod>{% endif %}
  </url>
  {%- endunless -%}
{%- endfor %}
</urlset>
